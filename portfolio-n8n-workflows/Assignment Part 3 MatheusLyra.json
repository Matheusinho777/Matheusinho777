    {
      "parameters": {
        "jsCode": "// map all the input data and put in the required structure\nconst holidays = $input.all().map(item=>{\n  return {\n    date: item.json.date,\n    holiday_name : item.json.localName\n    \n  };\n});\n\n// return the new strucutured data\nreturn [{\n  json: {\n    holidays: holidays\n  }\n  \n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        -320
      ],
      "id": "1dab014f-85fe-44f0-9086-a207c15ad9c9",
      "name": "defaultData"
    },
    {
      "parameters": {
        "jsCode": "// create the logic to turn the character of the string in upperCase and lowerCase one after the other.\nfunction alternatingCase(str) {\n  return str.split('').map((char, index) =>\n    index % 2 === 0 ? char.toUpperCase() : char.toLowerCase()\n  ).join('');\n}\n\n// map the input data and use the logic created to structure the data\nconst holidays = $input.all().map(item => {\n  return {\n    date: item.json.date,\n    holiday_name: alternatingCase(item.json.localName)\n  };\n});\n\n// return the new structured data\nreturn [{\n  json: {\n    holidays\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
