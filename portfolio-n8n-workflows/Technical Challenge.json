    {
      "parameters": {
        "jsCode": "const fields = ['full_name', 'email', 'budget', 'interest_level'];\nconst item = $input.first().json;\nconst result = {\n  allExist: true,\n  anyMissing: false,\n  missingFields: [],\n  validFields: []\n};\n\nfor (const field of fields) {\n  const value = item[field];\n  const exists = value !== undefined && value !== null && value !== '';\n\n  if (!exists) {\n    result.allExist = false;\n    result.anyMissing = true;\n    result.missingFields.push(field);\n  } else {\n    result.validFields.push(field);\n  }\n}\n\nreturn [{ json: result }];\n"
      },
