    {
      "parameters": {
        "jsCode": "const budget = $('setFields').first().json.budget;\nconst interest_level = $('setFields').first().json.interest_level;\n\nlet classification;\n\nif (budget > 6000 && interest_level === 'High') {\n  classification = 'Hot';\n} else if (budget >= 3000 && interest_level !== 'Low') {\n  classification = 'Warm';\n} else {\n  classification = 'Cold';\n}\n\nreturn [{\n  json: {\n    budget,\n    classification\n  }\n}];\n"
      },
